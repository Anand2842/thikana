DATABASE_URL="postgresql://postgres:[DB_PASSWORD]@db.[SUPABASE_REF].supabase.co:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://[SUPABASE_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="[publishable key]"
SUPABASE_SERVICE_ROLE_KEY="[service role key — server only]"
CRON_SECRET="[a random secret, at least 32 bytes]"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Production launch checklist (all required before public traffic):
# - NEXT_PUBLIC_SITE_URL="https://thikana.rent" (canonical domain)
# - Supabase Auth redirect URLs must include https://thikana.rent/auth/callback
# - Supabase Auth email sender configured (default sender is rate-limited;
#   use a custom SMTP provider for tenant sign-in, broker and admin access)
# - CRON_SECRET set identically in Vercel env (expire + reminders crons)
# - Visit/email/SMS notifications beyond in-app messages need a provider
#   (Resend/Twilio) — currently only in-app threads + dashboard reminders
# - Replace sample catalog; set NEXT_PUBLIC_DEMO_MODE="false"
# Mark sample catalog clearly. Disable only when replacing the sample catalog.
NEXT_PUBLIC_DEMO_MODE="true"

# Publish real operator information before public launch. These values are
# displayed on Terms/Privacy pages; never put credentials in them.
LEGAL_ENTITY_NAME=""
LEGAL_POSTAL_ADDRESS=""
LEGAL_CONTACT_EMAIL=""
GRIEVANCE_OFFICER_NAME=""
GRIEVANCE_CONTACT_EMAIL=""
DATA_HOSTING_LOCATIONS=""
